{
  "name": "nginx-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Web dashboard that controls NGINX via buttons instead of the command line",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server.js",
    "totp:new": "node scripts/totp.mjs",
    "test": "node test/smoke.mjs && node test/safe-apply.mjs",
    "test:docker": "node test/docker-conf.mjs",
    "test:e2e": "docker build -f test/Dockerfile.e2e -t nginx-dashboard-e2e . && docker run --rm nginx-dashboard-e2e"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "chart.js": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}