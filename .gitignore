node_modules/
test/fixtures/
# no trailing slash: `test/probe-*/` only matches a *directory*, so a stray probe-*.sh
# sitting in test/ would sail straight into `git add -A`
test/probe-*
*.log
.env
# Playwright MCP scratch dir — screenshots and snapshots from driving the UI locally
.playwright-mcp/

# Local-only working notes: an agent context handoff, the ops/secret policy, and the
# architecture notes. All three are kept on disk for working here and are deliberately
# not published.
AGENT.md
GUARDRAIL.md
ARCHITECTURE.md

# Pre-push secret scanner. Local-only for the same reason as the notes above: its pattern
# list is an inventory of what this project stores in plaintext, and where.
scripts/guardrail.mjs

# The supplied brand package — the working folder and the archive it arrived as. The assets the
# app actually loads are copied into public/ and those *are* tracked; this is only the source.
NXD-Branding-icons/
NXD-Branding-icons.zip
